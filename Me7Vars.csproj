<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>me7vars</AssemblyName>
    <RootNamespace>Me7Vars</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- reference pairs (bin + A2L) are copied next to the exe and picked up automatically -->
    <None Include="references\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
